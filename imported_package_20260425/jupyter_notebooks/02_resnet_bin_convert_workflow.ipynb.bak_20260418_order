    "# ResNet To Horizon Bin Workflow\n",
    "\n",
    "这个 notebook 适用于当前服务器上的 `10_model_convert/mapper` 示例，也适合类似的 ResNet/分类/回归 ONNX 模型转换。\n",
    "\n",
    "默认指向当前已经验证过的一套目录。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "ee7ec791",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "MAPPER_DIR = /home/ubuntu/horizon_x5_open_explorer_v1.2.8-py310_20240926/samples/ai_toolchain/horizon_model_convert_sample/03_classification/10_model_convert/mapper\n"
     ]
    }
   ],
   "source": [
    "from pathlib import Path\n",
    "import subprocess\n",
    "import shlex\n",
    "\n",
    "OE_ROOT = Path('/home/ubuntu/horizon_x5_open_explorer_v1.2.8-py310_20240926')\n",
    "SAMPLE_ROOT = OE_ROOT / 'samples/ai_toolchain/horizon_model_convert_sample/03_classification'\n",
    "WORK_NAME = '10_model_convert'\n",
    "SRC_WORK_DIR = Path('/home/ubuntu/10_model_convert')\n",
    "MAPPER_DIR = SAMPLE_ROOT / WORK_NAME / 'mapper'\n",
    "ONNX_FILE = 'best_line_follower_model_xy.onnx'\n",
    "CONFIG_FILE = 'resnet18_config.yaml'\n",
    "DOCKER_IMAGE = 'openexplorer/ai_toolchain_ubuntu_20_x5_cpu:v1.2.8-py310'\n",
    "MARCH = 'bayes-e'\n",
    "PTH_FILE = Path('/home/ubuntu/best_line_follower_model_xy.pth')\n",
    "\n",
    "print('MAPPER_DIR =', MAPPER_DIR)\n",
    "\n",
    "\n",
    "def run(cmd: str):\n",
    "    print(f'\\n$ {cmd}\\n')\n",
    "    completed = subprocess.run(cmd, shell=True, executable='/bin/bash', text=True, capture_output=True)\n",
    "    if completed.stdout:\n",
    "        print(completed.stdout)\n",
    "    if completed.stderr:\n",
    "        print(completed.stderr)\n",
    "    if completed.returncode != 0:\n",
    "        raise RuntimeError(f'Command failed with exit code {completed.returncode}')\n",
    "    return completed\n",
    "\n"
   ]
  },
