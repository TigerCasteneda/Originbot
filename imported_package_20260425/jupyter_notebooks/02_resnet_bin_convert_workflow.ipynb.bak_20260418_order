    "## 2. 可选：从 `.pth` 重新导出 ONNX\n",
    "\n",
    "如果当前 `onnx` 文件损坏，可以执行这一格重新导出。\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "7b0f7180",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "$ source ~/miniconda3/etc/profile.d/conda.sh && conda run -n yolo11 python /tmp/export_resnet_onnx_for_notebook.py\n",
      "\n",
      "/home/ubuntu/horizon_x5_open_explorer_v1.2.8-py310_20240926/samples/ai_toolchain/horizon_model_convert_sample/03_classification/10_model_convert/mapper/best_line_follower_model_xy.onnx\n",
      "\n",
      "/home/ubuntu/venvs/yolo11/lib/python3.10/site-packages/torchvision/models/_utils.py:223: UserWarning: Arguments other than a weight enum or `None` for 'weights' are deprecated since 0.13 and may be removed in the future. The current behavior is equivalent to passing `weights=None`.\n",
      "  warnings.warn(msg)\n",
      "\n"
     ]
    }
   ],
   "source": [
    "if PTH_FILE.exists():\n",
    "    script = f'''\n",
    "import torch\n",
    "import torchvision\n",
    "import onnx\n",
    "pth = {str(PTH_FILE)!r}\n",
    "out = {str(MAPPER_DIR / ONNX_FILE)!r}\n",
    "model = torchvision.models.resnet18(weights=False)\n",
    "model.fc = torch.nn.Linear(512, 2)\n",
    "state = torch.load(pth, map_location='cpu')\n",
    "model.load_state_dict(state)\n",
    "model.eval()\n",
    "x = torch.randn(1, 3, 224, 224)\n",
    "torch.onnx.export(model, x, out, export_params=True, opset_version=11, do_constant_folding=True, input_names=['input'], output_names=['output'])\n",
    "m = onnx.load(out)\n",
    "onnx.checker.check_model(m)\n",
    "print(out)\n",
    "'''\n",
    "    tmp = Path('/tmp/export_resnet_onnx_for_notebook.py')\n",
    "    tmp.write_text(script, encoding='utf-8')\n",
    "    run(f'source ~/miniconda3/etc/profile.d/conda.sh && conda run -n yolo11 python {tmp}')\n",
    "else:\n",
    "    print('PTH file not found, skip ONNX export and use existing ONNX')\n",
    "\n",
    "assert (MAPPER_DIR / ONNX_FILE).exists(), f'ONNX not found: {MAPPER_DIR / ONNX_FILE}'\n",
    "\n"
   ]
  },
